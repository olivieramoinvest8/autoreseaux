{
  "name": "amo-social-bot",
  "version": "0.1.0",
  "private": true,
  "description": "Automatisation des posts réseaux sociaux d'AMO Invest (Graveson, 13690) avec Claude Code.",
  "scripts": {
    "render:image": "node render/render-image.js",
    "test:image": "node render/render-image.js --template templates/post-feed.html --data content/examples/post-test.json --out output/post-feed-test.png",
    "test:story": "node render/render-image.js --template templates/post-story.html --data content/examples/post-test.json --out output/post-story-test.png",
    "test:datacard": "node render/render-image.js --template templates/datacard.html --data content/examples/datacard-test.json --out output/datacard-test.png",
    "test:listings": "node netlify/functions/_lib/listings.js --test",
    "test:functions": "node --check netlify/functions/*.js && node --check netlify/functions/_lib/*.js && node --check netlify/functions/_lib/publish/*.js && echo 'syntaxe OK'",
    "test:annonce": "node render/render-image.js --template templates/annonce-feed.html --data content/runs/2026-09-08-annonce-458.json --out output/annonce-test.png",
    "render:carousel": "node render/render-carousel.js",
    "fetch:media": "node render/fetch-media.js"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "playwright": "1.56.1"
  },
  "dependencies": {
    "@sparticuz/chromium-min": "^149.0.0",
    "@supabase/supabase-js": "^2.45.0",
    "cheerio": "^1.0.0",
    "puppeteer-core": "^24.43.1"
  }
}
